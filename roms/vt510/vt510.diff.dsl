set_note(address=CODE:0x71979..0x719D7, note=Note(id="0000000000000KCH5MX05H68BP", content="RAM test: for pattern R0 (0xAA, 0x55, then 0 after 0x3107), writes 0x7FC9 = 0, 1, 2, 3 and tests the 32KB window 0x8000-0xFFFF each time. So on the VT510 0x7FC9 selects the RAM page behind 0x8000 (VT520: 0x7FB6; 0x7FC9 is the VT520 blitter command). Four pages = 128KB.", tags=["hw", "selftest"], fields={}, links=[]))
set_note(address=CODE:0xD518..0xD5CF, note=Note(id="0000000000000N1VM2627P46BS", content="Video format shadows. 0x76EB (-> 0x7FCF): bit 4 = 132 columns (bit 0x4D; 0x682B = 0x84 or 0x50), bit 6 = setting 0x6913 bit 4 (bit 0x1C, attribute bit 7 = dim with WYSE), bit 2 set 0xD583 / cleared 0xD596 when 0x69A2 = 0, bit 5 set 0xD5A9 / cleared 0xD5B3, bit 3 toggled 0xD5A0. 0x76EC (-> 0x7FD2) = horizontal position: (setting 0x690A + 14) / 11 at 80 columns or (0x690A + 50) / 8 at 132, quotient in the high nibble, remainder in the low. 0x76ED (-> 0x7FD3) = vertical position: setting 0x6909 - 13 (- 10 with 0x6902 bit 4), clamped 0-0x1F.", tags=["hw", "video"], fields={}, links=[]))
set_note(address=CODE:0x71AF1..0x71B5C, note=Note(id="0000000000000PQNS3ST5RMS5Q", content="Keyboard power-up. Cold start (B.0 clear): 0x1B9B releases the line and bit-bangs the keyboard's own self-test byte by polling 0x7FFB bit 5 (the clock): high, falling edge, then ten low/high cycles with each half 2 to about 20 polls, then inhibit/release and read 0x7FFA (the 0x0E writes to 0x7FFB acknowledge, latching the byte). Not 0xAA: send 0xFE, then 0xFF (expects 0xFA, 0xAA). Then 0xF2 (0xFA, 0xAB, ID) and 0xAF (0xFE = PC keyboard, sets bit 0x12). Failure gives 'Keyboard Error - 4'. The VT520 sends commands instead of waiting for the power-up byte.", tags=["keyboard", "selftest"], fields={}, links=[]))
set_note(address=CODE:0x903..0x944, note=Note(id="0000000000000PRZK6YWPF9A3V", content="Glyph blit (VT520 command 0x9C at 0x7FC9). The VT510 blitter registers sit at 0x7F80-0x7F9F with a second copy at +0x40 (0x7FC0-0x7FDF); the firmware writes both, or only the 0xCx copy. Char R2 -> 0x80/0xC0, attribute R3 -> 0x81/0xC1 and 0x8D/0xCD (bit 7 cleared in WYSE mode, bit 0x62, when 0x1C is set), column R7-1 (doubled on double-width lines, bit 0x6C) -> 0x83/0xC3, scan line -> 0xC4 (from the line table at XDATA 0x0100 + row, 0x0944). Waits for P1.0, then command 0x98 -> 0x95/0xD5. VT510 commands: 0x98 glyph, 0xB8 soft glyph, 0xF8, 0x9A fill, 0x03/0x13 copy, 0x8D/0x9D; the same as the VT520's with bit 2 clear (VT520 0x9C/0xBC/0xFC/0x9E).", tags=["blitter", "hw"], fields={}, links=[]))
set_note(address=CODE:0x717F0..0x71921, note=Note(id="0000000000000R70RM4EK081K3", content="VT510 reset entry (same shape as VT525 bank 7 0x2947). Sets P1.3, clears P1.2/P1.1 (I2C), sets P1.0, loads powerup_reg_table (0x1921, (register, value) pairs into 0x7Fxx; the VT520's table has 3-byte entries), pulses 0x7FD0 (0xE4, delay, 0x04) on a cold start, tests internal RAM, checks for the factory loopback on comm1 (0x1AF1, B = 0xB6), then runs ROM and RAM tests (0x0038, 0x1952, 0x19D7) and selftest_dispatch (0x176D). Leaves through 0x0F08 to bank 0 main_entry (0x1CEC).", tags=["reset"], fields={}, links=[]))
set_note(address=CODE:0xE300..0xE4D9, note=Note(id="0000000000000SWT91116EQAD0", content="NVR (24C16-style EEPROM on P1.1 SCL / P1.2 SDA, device 0xA0). RAM image at 0x6A00: 0xE423 sets the EEPROM address from DPTR - 0x6A00. 0xE348 reads a block into RAM, 0xE315 reads and checks, 0xE377 compares each byte with RAM and writes only differing ones through 0xE3E1 (write, poll for the ack, read back, compare). 0xE4A7 START checks SDA/SCL at every step; 0xE496 STOP; 0xE474 sends a byte, 0xE461 reads one.", tags=["hw", "nvr"], fields={}, links=[]))
set_note(address=CODE:0x1D1F..0x1D6C, note=Note(id="0000000000000T7WR8K7QW67WY", content="Boot wait loop (VT520 bank 0 0x2410): runs until bit 0x21 (Set-Up), bit 0x2F (ordinary key) or host activity (bit 0x2B with XDATA 0x60D8 = 0), with 0x690B bit 4 taking the 0xF482 path instead. Then sets bit 0x22 (normal operation) and falls into the main loop.", tags=["reset"], fields={}, links=[]))
set_note(address=CODE:0x71921..0x71952, note=Note(id="0000000000000TEN35SXND35YM", content="Power-up register writes, (register, value) pairs into 0x7Fxx, 0-terminated: F6=00 D2=40 D3=11 CF=01 CF=04 D0=04 C8=FE C9=03 CA=0F CB=3F CC=3F E2=C0 ED=C0 EB=01 EC=55 EF=FB F0=00 F2=64 F3=FC F1=04 D9=02 ED=C0 ED=C0 F4=80. Comm1 (0xEB-0xF4, 0xD9) matches the VT520 except the receive ring page (0x64 vs 0x28); no comm2 entries; no VT520 timing (0xA4-0xA7) or window (0xB0-0xBF) registers.", tags=["hw"], fields={}, links=[]))
set_note(address=CODE:0x6190..0x61A7, note=Note(id="0000000000000TVX874X9BF1GT", content="Row allocation: takes free stored rows from the pool at XDATA 0x6000 (0xFF = taken, 0x5D22) and writes each to the display line table through P2 = 0x00, R0 (0x0000/0x0080: the tables the display reads) and to the firmware's row map at 0x0100 + row. Values are the stored row's scan line / 2 (0x08 per 16-line row).", tags=["memory", "video"], fields={}, links=[]))
set_note(address=CODE:0x57E3A..0x57F51, note=Note(id="0000000000000VVWBFM9VHF0S0", content="Set-Up arrow keys with modifiers (R2: 4 Up, 5 Down, 6 Right, 7 Left). With bit 0x08 held (Shift, as on the VT520): Up/Down change the vertical screen position 0x6A09 -> 0x6909 (0x0E-0x2C, or 0x0B-0x28 in the other mode), Left/Right the horizontal position 0x6A0A -> 0x690A (0x0B-0x32). With bit 0x0A (Ctrl) and P1.3 low: Left/Right step 0x6A08 -> 0x6908 by 0x10 (16 levels, wrapping); 0x06F6 sends its high nibble to 0x7FF4 bits 7-4, probably monitor brightness or contrast. Not in the VT520.", tags=["hidden", "setup", "video"], fields={}, links=[]))
set_note(address=CODE:0x7286D..0x72938, note=Note(id="0000000000000Y3ZZJQYSXG05M", content="Transmitter check (comm1 with PSW.1 clear, comm3 with it set). 0x7FDB / 0x7FDA are transmitter status here: bit 3 = holding register free, bit 2 = all sent, both clear while disabled. Steps: disabled -> bit 3 clear; +5 = 0x08 and +2 = 0x01 -> bits 3 and 2 set, +5 bit 3 set, INT1 (P3.3) low; two bytes written to +3 -> bits clear, +5 bit 3 clear, INT1 high; after one byte time (0x2DE5) bit 3 set, bit 2 clear, INT1 low; after another, bit 2 set. Failure (PSW.5) sets IDATA 0x1F bit 1 (comm1, 'RS-232 Port Data Error - 2', 0x2736) or bit 4 (comm3, 'DEC-423 Port Error - 5', 0x2742).", tags=["comm", "selftest"], fields={}, links=[]))
set_note(address=CODE:0x165..0x190, note=Note(id="0000000000000YM0R3EDJY16KM", content="Frame interrupt (0x7FFB bit 4, acknowledged by writing 0x10): waits for P3.4 low, then copies RAM shadows to the video registers: XDATA 0x76EB -> 0x7FCF (display control), 0x76EC -> 0x7FD2 (horizontal position), 0x76ED -> 0x7FD3 (vertical position). The VT520 does this staging in hardware (0x7F00-0x7F7F copies).", tags=["hw", "video"], fields={}, links=[]))
